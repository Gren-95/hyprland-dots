#!/usr/bin/python3
"""Render a Nautilus thumbnail for a 3D model: STL (binary or ASCII), binary
glTF (.glb) or Wavefront OBJ.

Usage: model-thumbnailer <input> <output.png> [size]

Pure numpy + Pillow software renderer, so it runs headless inside the file
manager's thumbnail sandbox (which only sees /usr and has no display).
Installed to /usr/local/bin by `dots.sh setup`.
"""
import json
import re
import struct
import sys

import numpy as np
from PIL import Image, ImageDraw, ImageFont

SUPERSAMPLE = 2
MAX_TRIANGLES = 200_000
SUPERSAMPLE_LIMIT = 60_000  # above this many triangles, skip supersampling for speed
BACKGROUND = (176, 176, 176)
BASE_COLOR = np.array([74, 144, 226], dtype=float)
AZIMUTH_DEG = -35.0
TILT_DEG = -58.0  # negative: camera above the model looking down (z-up stays up)
MARGIN = 0.08
LABEL_FONT = "/usr/share/fonts/liberation-sans-fonts/LiberationSans-Regular.ttf"
LABEL_COLOR = (70, 70, 70)
LABEL_HEIGHT = 0.12  # fraction of the thumbnail size
LABEL_PADDING = 0.04


def load_stl(data):
    if len(data) >= 84:
        count = struct.unpack_from("<I", data, 80)[0]
        if len(data) == 84 + 50 * count:
            dtype = np.dtype([("n", "<f4", 3), ("v", "<f4", (3, 3)), ("a", "<u2")])
            return np.frombuffer(data, dtype=dtype, count=count, offset=84)["v"].astype(float)
    numbers = re.findall(rb"vertex\s+(\S+)\s+(\S+)\s+(\S+)", data)
    coords = np.array(numbers, dtype=float)
    return coords.reshape(-1, 3, 3)


def y_up_to_z_up(triangles):
    """glTF and most OBJ exports are y-up; the renderer expects z-up."""
    return triangles[..., [0, 2, 1]] * np.array([1.0, -1.0, 1.0])


def load_obj(data):
    """Vertices and faces only; polygons are fan-triangulated, negative
    (relative) indices are resolved, texture/normal indices are ignored."""
    vertices, triangles = [], []
    for raw in data.splitlines():
        parts = raw.split()
        if not parts:
            continue
        if parts[0] == b"v" and len(parts) >= 4:
            vertices.append((float(parts[1]), float(parts[2]), float(parts[3])))
        elif parts[0] == b"f" and len(parts) >= 4:
            idx = []
            for token in parts[1:]:
                i = int(token.split(b"/")[0])
                idx.append(i - 1 if i > 0 else len(vertices) + i)
            for k in range(1, len(idx) - 1):
                triangles.append((idx[0], idx[k], idx[k + 1]))
    if not vertices or not triangles:
        raise ValueError("no faces in OBJ")
    return y_up_to_z_up(np.array(vertices, dtype=float)[np.array(triangles)])


# Includes the integer types KHR_mesh_quantization allows for positions.
GLTF_COMPONENTS = {5120: "<i1", 5121: "<u1", 5122: "<i2", 5123: "<u2", 5125: "<u4", 5126: "<f4"}
GLTF_NORMALIZE = {5120: 127.0, 5121: 255.0, 5122: 32767.0, 5123: 65535.0}
GLTF_WIDTH = {"SCALAR": 1, "VEC3": 3}


def _gltf_accessor(gltf, binary, index):
    acc = gltf["accessors"][index]
    view = gltf["bufferViews"][acc["bufferView"]]
    dtype = np.dtype(GLTF_COMPONENTS[acc["componentType"]])
    width = GLTF_WIDTH[acc["type"]]
    start = view.get("byteOffset", 0) + acc.get("byteOffset", 0)
    stride = view.get("byteStride", 0) or dtype.itemsize * width
    count = acc["count"]
    out = np.empty((count, width), dtype=float)
    for c in range(width):
        out[:, c] = np.ndarray((count,), dtype=dtype, buffer=binary,
                               offset=start + c * dtype.itemsize, strides=(stride,))
    if acc.get("normalized") and acc["componentType"] in GLTF_NORMALIZE:
        out /= GLTF_NORMALIZE[acc["componentType"]]
    return out if width > 1 else out[:, 0].astype(np.int64)


def _node_matrix(node):
    if "matrix" in node:
        return np.array(node["matrix"], dtype=float).reshape(4, 4).T
    t = node.get("translation", [0, 0, 0])
    x, y, z, w = node.get("rotation", [0, 0, 0, 1])
    sx, sy, sz = node.get("scale", [1, 1, 1])
    rot = np.array([
        [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
    ])
    m = np.eye(4)
    m[:3, :3] = rot * np.array([sx, sy, sz])
    m[:3, 3] = t
    return m


def load_glb(data):
    """Binary glTF: every triangle primitive of every mesh in the default
    scene, placed by its node transforms. Compressed meshes (Draco,
    meshopt) are not supported and give no thumbnail."""
    magic, _version, _length = struct.unpack_from("<4sII", data, 0)
    if magic != b"glTF":
        raise ValueError("not a GLB file")
    offset, gltf, binary = 12, None, None
    while offset + 8 <= len(data):
        chunk_len, chunk_type = struct.unpack_from("<II", data, offset)
        chunk = data[offset + 8: offset + 8 + chunk_len]
        if chunk_type == 0x4E4F534A:
            gltf = json.loads(chunk)
        elif chunk_type == 0x004E4942:
            binary = chunk
        offset += 8 + chunk_len
    if gltf is None or binary is None:
        raise ValueError("GLB without JSON or BIN chunk")

    nodes = gltf.get("nodes", [])
    scenes = gltf.get("scenes", [{"nodes": list(range(len(nodes)))}])
    roots = scenes[gltf.get("scene", 0)].get("nodes", [])
    parts = []

    def visit(index, parent):
        node = nodes[index]
        world = parent @ _node_matrix(node)
        if "mesh" in node:
            for prim in gltf["meshes"][node["mesh"]]["primitives"]:
                if prim.get("mode", 4) != 4 or "POSITION" not in prim["attributes"]:
                    continue
                pos = _gltf_accessor(gltf, binary, prim["attributes"]["POSITION"])
                idx = (_gltf_accessor(gltf, binary, prim["indices"]) if "indices" in prim
                       else np.arange(len(pos)))
                pos = pos @ world[:3, :3].T + world[:3, 3]
                parts.append(pos[idx[: len(idx) // 3 * 3].reshape(-1, 3)])
        for child in node.get("children", []):
            visit(child, world)

    for root in roots:
        visit(root, np.eye(4))
    if not parts:
        raise ValueError("no triangle meshes in GLB")
    return y_up_to_z_up(np.concatenate(parts))


def load_triangles(path):
    """Triangles (N x 3 x 3, z-up) and the label for the thumbnail corner."""
    data = open(path, "rb").read()
    if data[:4] == b"glTF":
        return load_glb(data), "GLB"
    if path.lower().endswith(".obj"):
        return load_obj(data), "OBJ"
    return load_stl(data), "STL"


def view_matrix():
    az, tilt = np.radians(AZIMUTH_DEG), np.radians(TILT_DEG)
    rot_z = np.array([[np.cos(az), -np.sin(az), 0], [np.sin(az), np.cos(az), 0], [0, 0, 1]])
    rot_x = np.array([[1, 0, 0], [0, np.cos(tilt), -np.sin(tilt)], [0, np.sin(tilt), np.cos(tilt)]])
    return rot_x @ rot_z


def add_label(image, label):
    size = image.width
    font = ImageFont.truetype(LABEL_FONT, max(8, round(size * LABEL_HEIGHT)))
    draw = ImageDraw.Draw(image)
    padding = round(size * LABEL_PADDING)
    draw.text((size - padding, padding), label, font=font, fill=LABEL_COLOR, anchor="ra")
    return image


def render(triangles, size, label):
    if len(triangles) > MAX_TRIANGLES:
        triangles = triangles[:: len(triangles) // MAX_TRIANGLES + 1]

    # Model z-up -> view space (x right, y toward viewer's up, z toward camera).
    rotated = triangles @ view_matrix().T
    rotated -= (rotated.reshape(-1, 3).max(axis=0) + rotated.reshape(-1, 3).min(axis=0)) / 2

    edge1 = rotated[:, 1] - rotated[:, 0]
    edge2 = rotated[:, 2] - rotated[:, 0]
    normals = np.cross(edge1, edge2)
    lengths = np.linalg.norm(normals, axis=1)
    keep = (lengths > 1e-12) & (normals[:, 2] > 0)
    rotated, normals, lengths = rotated[keep], normals[keep], lengths[keep]
    if len(rotated) == 0:
        raise ValueError("no visible triangles")
    normals /= lengths[:, None]

    light = np.array([-0.4, 0.6, 0.7])
    light /= np.linalg.norm(light)
    shade = 0.35 + 0.65 * np.clip(normals @ light, 0, 1)

    span = np.abs(rotated[:, :, :2]).max()
    canvas = size * (SUPERSAMPLE if len(rotated) <= SUPERSAMPLE_LIMIT else 1)
    scale = canvas * (0.5 - MARGIN) / span
    screen = rotated[:, :, :2] * scale
    screen[:, :, 0] += canvas / 2
    screen[:, :, 1] = canvas / 2 - screen[:, :, 1]

    order = np.argsort(rotated[:, :, 2].mean(axis=1))
    image = Image.new("RGB", (canvas, canvas), BACKGROUND)
    draw = ImageDraw.Draw(image)
    for index in order:
        color = tuple((BASE_COLOR * shade[index]).astype(int))
        points = [tuple(point) for point in screen[index]]
        draw.polygon(points, fill=color, outline=color)
    return add_label(image.resize((size, size), Image.LANCZOS), label)


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: model-thumbnailer <input> <output.png> [size]")
    size = int(sys.argv[3]) if len(sys.argv) > 3 else 256
    triangles, label = load_triangles(sys.argv[1])
    render(triangles, size, label).save(sys.argv[2], "PNG")


if __name__ == "__main__":
    main()
