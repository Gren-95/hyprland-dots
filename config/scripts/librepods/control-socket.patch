+
+// Settings the daemon has seen, mirrored to $XDG_RUNTIME_DIR/librepods-controls.json
+// for the Quickshell Bluetooth flyout (written atomically, merged per key).
+fn write_control_state(key: &str, value: serde_json::Value) {
+    static STATE: std::sync::Mutex<Option<serde_json::Map<String, serde_json::Value>>> =
+        std::sync::Mutex::new(None);
+    let Ok(runtime_dir) = std::env::var("XDG_RUNTIME_DIR") else {
+        return;
+    };
+    let mut guard = match STATE.lock() {
+        Ok(g) => g,
+        Err(_) => return,
+    };
+    let map = guard.get_or_insert_with(serde_json::Map::new);
+    map.insert(key.to_string(), value);
+    let path = std::path::Path::new(&runtime_dir).join("librepods-controls.json");
+    let tmp_path = path.with_extension("json.tmp");
+    if std::fs::write(&tmp_path, serde_json::Value::Object(map.clone()).to_string()).is_ok() {
+        let _ = std::fs::rename(&tmp_path, &path);
+    }
+}
+
+// Commands from the Quickshell Bluetooth flyout, one per line on
+// $XDG_RUNTIME_DIR/librepods.sock (the runtime dir is private to the user):
+//   listening-mode <1 off | 2 noise cancellation | 3 transparency | 4 adaptive>
+//   conversation-detect <on|off>
+fn spawn_control_socket(
+    command_tx: tokio::sync::mpsc::UnboundedSender<(ControlCommandIdentifiers, Vec<u8>)>,
+) {
+    let Ok(runtime_dir) = std::env::var("XDG_RUNTIME_DIR") else {
+        return;
+    };
+    let path = std::path::Path::new(&runtime_dir).join("librepods.sock");
+    let _ = std::fs::remove_file(&path);
+    let listener = match tokio::net::UnixListener::bind(&path) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("control socket: {}", e);
+            return;
+        }
+    };
+    tokio::spawn(async move {
+        use tokio::io::AsyncBufReadExt;
+        while let Ok((stream, _)) = listener.accept().await {
+            let tx = command_tx.clone();
+            tokio::spawn(async move {
+                let mut lines = tokio::io::BufReader::new(stream).lines();
+                while let Ok(Some(line)) = lines.next_line().await {
+                    let mut parts = line.split_whitespace();
+                    match (parts.next(), parts.next()) {
+                        (Some("listening-mode"), Some(v)) => {
+                            if let Ok(mode @ 1..=4) = v.parse::<u8>() {
+                                let _ = tx.send((ControlCommandIdentifiers::ListeningMode, vec![mode]));
+                            }
+                        }
+                        (Some("conversation-detect"), Some(v)) => {
+                            let on = v == "on";
+                            let _ = tx.send((
+                                ControlCommandIdentifiers::ConversationDetectConfig,
+                                vec![if on { 0x01 } else { 0x02 }],
+                            ));
+                            write_control_state("conversation_detect", serde_json::json!(on));
+                        }
+                        _ => log::warn!("control socket: unknown command {:?}", line),
+                    }
+                }
+            });
+        }
+    });
+}
