# quickshell — btop theme matching the warm stone palette in
# quickshell/Theme.qml. Keep the two in sync.
#
# Surfaces: bg #1c1917, bgActive #332e2b, border #3a3633.
# accentPrimary is "blue" (quickshell/settings/accent-primary); semantic
# accents stay fixed — green = ok, yellow = warn, red = danger.

# Main background — matches Theme.bg (and kitty's background)
theme[main_bg]="#1c1917"

# Main text color — Theme.fg
theme[main_fg]="#fafaf9"

# Title color for boxes
theme[title]="#fafaf9"

# Highlight color for keyboard shortcuts — Theme.accentPrimary
theme[hi_fg]="#ff7a1a"

# Selected process row — Theme.bgActive, the shell's "active pill" surface
theme[selected_bg]="#332e2b"
theme[selected_fg]="#fafaf9"

# Inactive/disabled text — Theme.disabled
theme[inactive_fg]="#57534e"

# Text drawn over graphs — Theme.muted
theme[graph_text]="#a8a29e"

# Meter track behind the filled portion — Theme.bgActive
theme[meter_bg]="#332e2b"

# Misc process-box colors (mini cpu graphs, detail graphs, status text)
theme[proc_misc]="#a8a29e"

# Box outlines and dividers — Theme.border
theme[cpu_box]="#3a3633"
theme[mem_box]="#3a3633"
theme[net_box]="#3a3633"
theme[proc_box]="#3a3633"
theme[div_line]="#3a3633"

# Temperature — severity ramp, ok to danger
theme[temp_start]="#2ee59d"
theme[temp_mid]="#ffc531"
theme[temp_end]="#ff4d5e"

# CPU load — starts on the accent, escalates through warn to danger
theme[cpu_start]="#4c9aff"
theme[cpu_mid]="#ffc531"
theme[cpu_end]="#ff4d5e"

# Mem/disk free — calm green, nothing to act on
theme[free_start]="#2ee59d"
theme[free_mid]="#2ee6d6"
theme[free_end]="#2ee6d6"

# Mem/disk available
theme[available_start]="#2ee6d6"
theme[available_mid]="#2ee59d"
theme[available_end]="#2ee59d"

# Mem/disk cached — neutral slate, not a signal
theme[cached_start]="#b57bff"
theme[cached_mid]="#94a3b8"
theme[cached_end]="#94a3b8"

# Mem/disk used — same severity ramp as CPU
theme[used_start]="#4c9aff"
theme[used_mid]="#ffc531"
theme[used_end]="#ff4d5e"

# Network down — incoming reads as green
theme[download_start]="#2ee6d6"
theme[download_mid]="#2ee59d"
theme[download_end]="#2ee59d"

# Network up — outgoing reads as orange
theme[upload_start]="#ff7a1a"
theme[upload_mid]="#ff7a1a"
theme[upload_end]="#ffc531"

# Process CPU column gradient
theme[process_start]="#4c9aff"
theme[process_mid]="#ffc531"
theme[process_end]="#ff4d5e"
