{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/nobara-logo.png",
    "type": "kitty",
    "width": 40,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ]
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "○"
      },
      "width": 10,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────── \u001b[1;37mSystem\u001b[0;90m ────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": "  Kernel",
      "keyColor": "red",
      "text": "release=$(uname -r); echo \"$(uname -s) ${release%.$(uname -m)}\""
    },
    {
      "type": "os",
      "key": "  Arch",
      "keyColor": "red",
      "format": "{arch}"
    },
    {
      "type": "command",
      "key": "  Packages",
      "keyColor": "red",
      "text": "~/.config/fastfetch/count-packages.sh"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────── \u001b[1;37mDesktop\u001b[0;90m ────────────────────────┤"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "  Display",
      "keyColor": "yellow",
      "format": "{width}x{height}{?inch} in {inch}\"{?}, {refresh-rate} Hz"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────── \u001b[1;37mHardware\u001b[0;90m ───────────────────────┤"
    },
    {
      "type": "host",
      "key": "  Host",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "  CPU",
      "keyColor": "cyan",
      "text": "sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -n1 | sed -E 's/\\((R|TM)\\)//g; s/^[0-9]+th Gen //; s/ +/ /g'"
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "keyColor": "cyan",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": "  Memory",
      "keyColor": "cyan",
      "format": "{percentage-bar} {used} / {total}"
    },
    {
      "type": "disk",
      "key": "  Disk",
      "keyColor": "cyan",
      "format": "{size-percentage-bar} {size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "  Battery",
      "keyColor": "cyan",
      "format": "{capacity-bar} {capacity}{?time-formatted} · {?}{?time-hours}{time-hours}h {?}{?time-formatted}{time-minutes}m left{?}{/time-formatted} · {status}{/}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────┘"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
