# Backup files
*.backup
*.bak
*_bak_*
*.backup.*

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.kate-swp

# Sensitive credentials (symlinked but not committed)
immich/auth.yml
jellyfin/sync.conf
quickshell/calendar.url
quickshell/settings/
scripts/util.env

# Runtime artifacts
hypr/avatar.png
hypr/lockbg

# Fish runtime state (universal variables, regenerated by fish)
fish/fish_variables

# Machine-local fish function: hardcoded binary path, personal profile name
fish/functions/ofs.fish
/ranger/plugins/

# GTK bookmarks/servers (regenerated by Nautilus at runtime, absolute $HOME paths)
gtk-4.0/servers
gtk-3.0/bookmarks
