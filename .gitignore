# Backup files
*.backup
*.bak
*_bak_*
*.backup.*

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.kate-swp

# Sensitive credentials (symlinked but not committed)
config/immich/auth.yml
config/jellyfin/sync.conf
config/quickshell/calendar.url
config/quickshell/settings/
config/scripts/util.env
config/wayvnc/password
config/wayvnc/*.pem

# Runtime artifacts
config/hypr/avatar.png
config/hypr/lockbg

# Fish runtime state (universal variables, regenerated by fish)
config/fish/fish_variables

# Auto-generated by VS Code's bundled Copilot CLI
config/fish/completions/copilot.fish

# Machine-local fish function: hardcoded binary path, personal profile name
config/fish/functions/ofs.fish
/config/ranger/plugins/

# GTK bookmarks/servers (regenerated by Nautilus at runtime, absolute $HOME paths)
config/gtk-4.0/servers
config/gtk-3.0/bookmarks
brave/

# Python bytecode
__pycache__/
*.pyc
