#!/bin/bash
# Uncap battery charging on Fri/Sat/Sun, restore the 75-80% cap Mon-Thu.
#
# Fri-Sun uses Dell's "Standard" charge type (charges to 100%); the rest of
# the week uses "Custom" with a 75-80% window, which is easier on the cell.
# Runs from a systemd timer at midnight and again shortly after boot.
set -euo pipefail

CAP_START=75
CAP_END=80

# 1=Mon .. 7=Sun; 5,6,7 = Fri,Sat,Sun
day=$(date +%u)
if [ "$day" -ge 5 ]; then
    mode="Standard"
else
    mode="Custom"
fi

found=0
for bat in /sys/class/power_supply/BAT*; do
    [ -e "$bat/charge_types" ] || continue
    found=1
    echo "$mode" > "$bat/charge_types"
    if [ "$mode" = "Custom" ]; then
        # Write start before end: the driver rejects a start above the
        # current end, and start<end holds in both orders this way.
        [ -e "$bat/charge_control_start_threshold" ] && echo "$CAP_START" > "$bat/charge_control_start_threshold"
        [ -e "$bat/charge_control_end_threshold" ] && echo "$CAP_END" > "$bat/charge_control_end_threshold"
        echo "$(basename "$bat"): capped ($CAP_START-$CAP_END%)"
    else
        echo "$(basename "$bat"): uncapped (Standard, charges to 100%)"
    fi
done

if [ "$found" -eq 0 ]; then
    echo "no battery exposing charge_types found" >&2
    exit 1
fi
