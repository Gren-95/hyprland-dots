# Dark Qt palette matching quickshell/Theme.qml (stone neutrals, blue accent).
# Loaded by hyprqt6engine (theme:color_scheme) so Qt widgets, including the
# tray context menus Quickshell draws for nm-applet, stay dark.
[General]
ColorScheme=QuickshellDark
Name=Quickshell Dark

