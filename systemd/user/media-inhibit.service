[Unit]
Description=Inhibit idle while media is playing
# Started from the graphical session. restart.sh (Super+B) restarts it with
# `systemctl --user restart media-inhibit`. The Wayland/Hyprland environment is imported
# into the user manager by restart.sh (dbus-update-activation-environment).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/bin/bash %h/.config/scripts/media-inhibit.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
