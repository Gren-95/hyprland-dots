[Unit]
Description=Apply weekday battery charge cap (uncapped Fri-Sun)
Documentation=man:systemd.timer(5)
# Source lives in dots/scripts/battery-charge-schedule and is DEPLOYED AS A COPY
# to /usr/local/bin (root-owned): systemd runs this as root, so ExecStart must
# not point into a user-writable path.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/battery-charge-schedule

# Hardening: the script only writes battery thresholds under /sys.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/class/power_supply /sys/devices
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
